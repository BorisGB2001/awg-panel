# boris.gb 2026-10-28 21:12 - example panel settings; the working file is /opt/awg-panel/.env (mode 600), never commit it
# boris.gb 2026-10-29 07:26 - comments in English, real server address replaced with an example (public repository)

# --- access ---
# public IP (or domain) of the server; Caddy obtains a Let's Encrypt certificate for it
PANEL_HOST=203.0.113.10
# boris.gb 2026-10-29 00:35 - panel HTTPS port; after a change: ufw allow <port>/tcp and docker compose up -d --force-recreate caddy panel
PANEL_PORT=14443
ADMIN_USER=admin
# ./init-admin.sh fills ADMIN_PASSWORD_HASH and TOTP_SECRET
ADMIN_PASSWORD_HASH=
TOTP_SECRET=
# 32+ random bytes: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Fernet key for client private keys: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_KEY=
# false — only for local debugging without HTTPS
COOKIE_SECURE=true
# interface language by default (file panel/app/locales/<code>.json)
DEFAULT_LANG=en

# --- AmneziaWG ---
# Endpoint host written into client configs
PUBLIC_HOST=203.0.113.10
AWG_PROCESS_MATCH=amneziawg-go awg0
AWG_IFACE=awg0
AWG_DIR=/opt/amnezia/awg
VPN_SUBNET=10.8.1.0/24

# --- collection ---
TZ=Europe/Moscow
POLL_INTERVAL=30
ONLINE_WINDOW=180
COLLECT_HOSTS=true
RETENTION_RAW_DAYS=30
RETENTION_MIN_DAYS=7
RETENTION_EVENTS_DAYS=365

# --- alerts ---
ALERT_SHARED_CHANGES=6
ALERT_SHARED_WINDOW_MIN=30
ALERT_SPIKE_FACTOR=5
ALERT_SPIKE_MIN_BYTES=1073741824

# boris.gb 2026-10-28 22:15 - DNS and PersistentKeepalive in issued client configs (as in the AmneziaVPN export)
CLIENT_DNS=8.8.8.8, 8.8.4.4
CLIENT_KEEPALIVE=25-35

# boris.gb 2026-10-29 00:15 - client portal and notifications; empty — channel disabled
# bot token from @BotFather (keep it secret)
TELEGRAM_BOT_TOKEN=
# mail: 587 + STARTTLS or 465 + SMTP_SSL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
